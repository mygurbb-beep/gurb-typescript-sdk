{
  "name": "@gurb/embed",
  "version": "1.6.0",
  "description": "Browser SDK for embedding a Gurb community section. Never handles secret keys.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs,iife --global-name GurbEmbed --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@gurb/api-types": "^1.6.0"
  },
  "sideEffects": false,
  "license": "MIT",
  "author": "Gurb",
  "homepage": "https://mygurb.com",
  "bugs": {
    "url": "https://github.com/mygurbb-beep/gurb-typescript-sdk/issues"
  },
  "keywords": [
    "gurb",
    "mygurb",
    "community",
    "embed",
    "iframe",
    "widget"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mygurbb-beep/gurb-typescript-sdk.git",
    "directory": "packages/embed"
  },
  "publishConfig": {
    "access": "public"
  }
}
