{
  "name": "@gurb/server",
  "version": "0.1.0",
  "description": "Server-side Gurb SDK. Holds your API key — never import this in browser code.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": { "build": "tsup src/index.ts --format esm,cjs --dts --clean" },
  "dependencies": { "@gurb/api-types": "0.1.0" },
  "engines": { "node": ">=20" }
}
